#!/bin/sh
# Starts Claude Code inside the yena container, working on the whole project.
# Its CLAUDE.md and .claude/ live in .yena/claude, outside the project tree.
set -e

MODULE_DIR=$(cd "$(dirname "$0")/.." && pwd)
PROJECT_DIR=$(cd "$MODULE_DIR/../.." && pwd)
DATA_DIR="${YENA_DATA:-$PROJECT_DIR/.yena}/claude"
BIN="$MODULE_DIR/.runtime/node_modules/.bin/claude"
STAMP="$MODULE_DIR/.runtime/.last-update"

# Fetch the latest version if missing or not checked in the last 24h.
# If the update fails (e.g. offline), keep using the installed one.
if [ ! -x "$BIN" ] || [ -z "$(find "$STAMP" -mmin -1440 2>/dev/null)" ]; then
	"$MODULE_DIR/bin/install" || [ -x "$BIN" ]
fi

# Alpine needs the system ripgrep for Claude Code's search tools
if ! command -v rg >/dev/null 2>&1 && command -v apk >/dev/null 2>&1; then
	apk add -q --no-cache ripgrep >/dev/null 2>&1 || true
fi
if command -v rg >/dev/null 2>&1; then export USE_BUILTIN_RIPGREP=0; fi

# Claude's own files live in .yena/claude, never in the project itself:
#   .yena/claude/md/      — instructions: CLAUDE.md (loaded as if it were ./CLAUDE.md), SOUL.md
#   .yena/claude/config/  — config dir: settings, agents, commands, skills, login, history
MD_DIR="$DATA_DIR/md"
CLAUDE_DIR="$DATA_DIR/config"

# One-time move from the old layouts (.config + a generated CLAUDE.md, then .claude + md files in the root)
if [ -d "$DATA_DIR/.config" ] && [ ! -e "$CLAUDE_DIR" ]; then
	mv "$DATA_DIR/.config" "$CLAUDE_DIR"
	if head -n 1 "$CLAUDE_DIR/CLAUDE.md" 2>/dev/null | grep -q 'Generated by modules/claude'; then
		rm "$CLAUDE_DIR/CLAUDE.md"
	fi
fi
if [ -d "$DATA_DIR/.claude" ] && [ ! -e "$CLAUDE_DIR" ]; then
	mv "$DATA_DIR/.claude" "$CLAUDE_DIR"
fi
mkdir -p "$CLAUDE_DIR" "$MD_DIR"
for f in CLAUDE.md SOUL.md; do
	if [ -f "$DATA_DIR/$f" ] && [ ! -e "$MD_DIR/$f" ]; then
		mv "$DATA_DIR/$f" "$MD_DIR/$f"
	fi
done
# Agents and skills live in md/ (Claude may edit them there); the config dir links to them
for d in agents skills; do
	mkdir -p "$MD_DIR/$d"
	if [ ! -e "$CLAUDE_DIR/$d" ] && [ ! -L "$CLAUDE_DIR/$d" ]; then
		ln -s "../md/$d" "$CLAUDE_DIR/$d"
	fi
done

export CLAUDE_CONFIG_DIR="$CLAUDE_DIR"
# Load CLAUDE.md from --add-dir folders, i.e. .yena/claude/md/CLAUDE.md
export CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1
# Updates are handled above, not by Claude Code itself
export DISABLE_AUTOUPDATER=1

# Token from `claude setup-token` on the host. The browser login doesn't work well
# from the container: the long URL breaks when copied out of the terminal.
TOKEN_FILE="$DATA_DIR/.token"
if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ] && [ -s "$TOKEN_FILE" ]; then
	CLAUDE_CODE_OAUTH_TOKEN=$(tr -d ' \n\r' <"$TOKEN_FILE")
	export CLAUDE_CODE_OAUTH_TOKEN
fi

# Keep Claude from writing its files into the project (e.g. via /init or memory edits)
GUARD='{"permissions":{"deny":["Edit(./CLAUDE.md)","Edit(./CLAUDE.local.md)","Edit(./.claude/**)"]}}'
HINT="This project's Claude files live outside the project, in $DATA_DIR: \
instructions (CLAUDE.md, SOUL.md) in $MD_DIR (use $MD_DIR/CLAUDE.md wherever you would use ./CLAUDE.md, e.g. for /init or remembering things) \
and Claude config (settings, agents, commands, skills) in $CLAUDE_DIR (instead of ./.claude). \
Never create CLAUDE.md, CLAUDE.local.md or .claude/ inside $PROJECT_DIR."

cd "$PROJECT_DIR"
exec "$BIN" --add-dir "$MD_DIR" --settings "$GUARD" --append-system-prompt "$HINT" "$@"
