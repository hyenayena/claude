#!/bin/sh
# Installs or updates Claude Code to the latest version in .runtime/
set -e

MODULE_DIR=$(cd "$(dirname "$0")/.." && pwd)
RUNTIME="$MODULE_DIR/.runtime"

mkdir -p "$RUNTIME"
echo "Завантажую свіжу версію Claude Code…"
npm install --prefix "$RUNTIME" --no-audit --no-fund --silent @anthropic-ai/claude-code@latest
touch "$RUNTIME/.last-update"

if [ -f "$MODULE_DIR/package.json" ] && ! npm ls --prefix "$MODULE_DIR" --omit=dev --depth=0 >/dev/null 2>&1; then
	npm install --prefix "$MODULE_DIR" --no-audit --no-fund --silent || echo "Failed to install module dependencies"
fi

"$RUNTIME/node_modules/.bin/claude" --version
